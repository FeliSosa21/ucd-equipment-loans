@inherits LayoutComponentBase
@implements IDisposable
@inject SesionActual SesionActual
@inject NavigationManager Navigation

<header class="topbar">
    <Marca />

    <div class="sesion">
        @if (SesionActual.EstaIniciada)
        {
            <span class="usuario">
                <strong>@SesionActual.Usuario!.Nombre</strong>
                <small>@SesionActual.Usuario.Tipo</small>
            </span>
            <button class="btn btn-ghost btn-sm" @onclick="CerrarSesion">Salir</button>
        }
        else
        {
            <a class="btn btn-ghost btn-sm" href="ingresar">Ingresar</a>
            <a class="btn btn-primary btn-sm" href="registro">Crear cuenta</a>
        }
    </div>
</header>

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<ErrorInesperado />

@code {
    protected override void OnInitialized()
    {
        SesionActual.Cambio += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        ExigirCambioDeContrasena();
    }

    // Si el usuario debe cambiar la contrasena, no puede ir a otra pantalla hasta hacerlo.
    private void ExigirCambioDeContrasena()
    {
        if (SesionActual.EstaIniciada && SesionActual.Usuario!.DebeCambiarContrasena &&
            !Navigation.Uri.EndsWith("/cambiar-contrasena", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/cambiar-contrasena");
        }
    }

    private void CerrarSesion()
    {
        SesionActual.Cerrar();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        SesionActual.Cambio -= StateHasChanged;
    }
}
