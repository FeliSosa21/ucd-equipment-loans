@inherits LayoutComponentBase
@implements IDisposable
@inject SesionActual SesionActual
@inject NavigationManager Navigation

<header class="topbar">
    <a class="brand" href="">
        <span class="brand-logo mono">UCD</span>
        <span class="brand-text">
            <strong>UCD</strong>
            <small>Úsalo, cuídalo, devuélvelo entero</small>
        </span>
    </a>

    <div class="sesion">
        @if (SesionActual.EstaIniciada)
        {
            <span class="usuario">
                <strong>@SesionActual.Usuario!.Nombre</strong>
                <small>@SesionActual.Usuario.Tipo</small>
            </span>
            <button class="btn btn-ghost btn-sm" @onclick="CerrarSesion">Salir</button>
        }
        else
        {
            <a class="btn btn-ghost btn-sm" href="ingresar">Ingresar</a>
            <a class="btn btn-primary btn-sm" href="registro">Crear cuenta</a>
        }
    </div>
</header>

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        SesionActual.Cambio += StateHasChanged;
    }

    private void CerrarSesion()
    {
        SesionActual.Cerrar();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        SesionActual.Cambio -= StateHasChanged;
    }
}
