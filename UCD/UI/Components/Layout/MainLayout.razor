@inherits LayoutComponentBase

<header class="topbar">
    <a class="brand" href="">
        <span class="brand-logo mono">UCD</span>
        <span class="brand-text">
            <strong>UCD</strong>
            <small>Úsalo, cuídalo, devuélvelo entero</small>
        </span>
    </a>

    @* Cuando exista el login, esto se reemplaza por el avatar con nombre y tipo de usuario *@
    <div class="sesion">
        <a class="btn btn-ghost btn-sm" href="ingresar">Ingresar</a>
        <a class="btn btn-primary btn-sm" href="registro">Crear cuenta</a>
    </div>
</header>

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
