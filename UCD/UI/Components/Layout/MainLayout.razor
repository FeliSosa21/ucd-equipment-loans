@inherits LayoutComponentBase
@using Servicios
@implements IDisposable
@inject SesionActual SesionActual
@inject NavigationManager Navigation
@inject ServicioSesion ServicioSesion

<header class="topbar">
    <Marca />

    <div class="sesion">
        @if (SesionActual.EstaIniciada)
        {
            <span class="usuario">
                <strong>@SesionActual.Usuario!.Nombre</strong>
                <small>@SesionActual.Usuario.Tipo</small>
            </span>
            <button class="btn btn-ghost btn-sm" @onclick="CerrarSesion">Salir</button>
        }
        else
        {
            <a class="btn btn-ghost btn-sm" href="ingresar">Ingresar</a>
            <a class="btn btn-primary btn-sm" href="registro">Crear cuenta</a>
        }
    </div>
</header>

<div class="shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>
    <main class="content">
        @Body
    </main>
</div>

<ErrorInesperado />

@code {
    protected override void OnInitialized()
    {
        SesionActual.Cambio += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await RenovarSesionAsync();
        ExigirCambioDeContrasena();
        ExigirActivacion();
    }

    // En cada navegacion se traen los datos actuales: si el usuario fue desactivado, se cierra la sesion,
    // y si le cambiaron el tipo, el menu refleja los permisos nuevos.
    private async Task RenovarSesionAsync()
    {
        if (!SesionActual.EstaIniciada)
        {
            return;
        }

        try
        {
            SesionActual.Renovar(ServicioSesion.RenovarSesion(SesionActual.Usuario!.Dni));
        }
        catch (ServicioException)
        {
            await SesionActual.ExpirarAsync("Tu sesión se cerró porque tu cuenta ya no está activa.");
            Navigation.NavigateTo("/ingresar");
        }
    }

    // Si el usuario debe cambiar la contrasena, no puede ir a otra pantalla hasta hacerlo.
    private void ExigirCambioDeContrasena()
    {
        if (SesionActual.EstaIniciada && SesionActual.Usuario!.DebeCambiarContrasena &&
            !Navigation.Uri.EndsWith("/cambiar-contrasena", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/cambiar-contrasena");
        }
    }

    // Un usuario sin tipo asignado solo puede ver la pantalla que le explica que espere la activacion.
    private void ExigirActivacion()
    {
        if (SesionActual.EstaIniciada && SesionActual.Usuario!.PendienteDeActivacion &&
            !SesionActual.Usuario.DebeCambiarContrasena)
        {
            Navigation.NavigateTo("/pendiente-activacion");
        }
    }

    private async Task CerrarSesion()
    {
        await SesionActual.CerrarAsync();
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        SesionActual.Cambio -= StateHasChanged;
    }
}
