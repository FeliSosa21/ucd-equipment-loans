@page "/"
@using DTOs
@using Servicios
@inject SesionActual SesionActual
@inject ServicioPrestamo ServicioPrestamo

@if (!SesionActual.EstaIniciada)
{
    <PageTitle>UCD · Inicio</PageTitle>

    <div class="page-header">
        <h1>Bienvenido a UCD</h1>
        <p>Pedí equipamiento prestado de la universidad y seguí tus solicitudes.</p>
    </div>

    <EstadoVacio Titulo="Ingresá para empezar"
                 Mensaje="Con tu cuenta podés consultar el catálogo y solicitar préstamos.">
        <a class="btn btn-primary btn-sm" href="ingresar">Ingresar</a>
        <a class="btn btn-ghost btn-sm" href="registro">Crear cuenta</a>
    </EstadoVacio>
}
else if (!PuedeConsultarSusSolicitudes)
{
    @* Funcionario y Supervisor no solicitan prestamos: en el inicio solo ven la bienvenida y usan el menu. *@
    <PageTitle>UCD · Inicio</PageTitle>

    <div class="page-header">
        <h1>Hola, @SesionActual.Usuario!.Nombre</h1>
        <p>Elegí en el menú lo que querés hacer.</p>
    </div>
}
else
{
    <PageTitle>UCD · Mis solicitudes</PageTitle>

    <div class="page-header">
        <h1>Mis solicitudes y retiros</h1>
        <p>Tus solicitudes y préstamos con su estado, fecha de inicio y fecha esperada de devolución.</p>
    </div>

    <div class="card table-card">
        <table>
            <thead>
                <tr>
                    <th>Equipamiento</th>
                    <th>Estado</th>
                    <th>Fecha de inicio</th>
                    <th>Devolución esperada</th>
                    <th>Unidades asignadas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (PrestamoDto prestamo in _prestamos)
                {
                    <tr>
                        <td>@prestamo.TipoEquipamiento</td>
                        <td>
                            @prestamo.Estado
                            @if (prestamo.MotivoRechazo is not null)
                            {
                                <div class="hint">Motivo: @prestamo.MotivoRechazo</div>
                            }
                        </td>
                        <td>@(EsRechazado(prestamo) ? SinDato : prestamo.FechaHoraPrestamo.ToString(Formatos.FechaHora))</td>
                        <td>@(EsRechazado(prestamo) ? SinDato : prestamo.FechaEsperadaDevolucion.ToString(Formatos.Fecha))</td>
                        <td class="mono">@(prestamo.Unidades.Any() ? string.Join(", ", prestamo.Unidades) : SinDato)</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!_prestamos.Any())
        {
            <EstadoVacio Titulo="Todavía no tenés solicitudes"
                         Mensaje="Buscá un equipo en el catálogo para solicitar tu primer préstamo.">
                <a class="btn btn-primary btn-sm" href="catalogo">Ir al catálogo</a>
            </EstadoVacio>
        }
    </div>
}

@code {
    private const string SinDato = "—";

    private List<PrestamoDto> _prestamos = new List<PrestamoDto>();

    private bool PuedeConsultarSusSolicitudes =>
        SesionActual.Usuario!.Permisos.Contains(Permisos.ConsultarMisSolicitudes);

    // Requerimiento 7: las solicitudes y préstamos del usuario logueado, los más recientes primero.
    protected override void OnInitialized()
    {
        if (!SesionActual.EstaIniciada || !PuedeConsultarSusSolicitudes)
        {
            return;
        }

        _prestamos = ServicioPrestamo.ListarMisSolicitudes(SesionActual.Usuario!.Dni)
            .OrderByDescending(prestamo => prestamo.FechaHoraPrestamo)
            .ToList();
    }

    // Una solicitud rechazada nunca empezó: no tiene inicio ni devolución esperada que mostrar.
    private static bool EsRechazado(PrestamoDto prestamo) => prestamo.Estado == EstadosPrestamo.Rechazado;
}
