@page "/usuarios"
@using DTOs
@using Servicios
@inherits PaginaConSesion
@inject ServicioAdministracionUsuarios ServicioAdministracion

<PageTitle>UCD · Usuarios</PageTitle>

<div class="page-header">
    <h1>Usuarios</h1>
    <p>Asigná el tipo de usuario y activá o desactivá cuentas.</p>
</div>

<div class="toolbar">
    <button class="btn btn-primary btn-sm" @onclick="AbrirAlta" disabled="@_mostrarAlta">Nuevo usuario</button>
    <input class="field busqueda" type="search" placeholder="Buscar por nombre, CI o correo"
           aria-label="Buscar usuario"
           @bind="_busqueda" @bind:event="oninput" />
</div>

@if (_mostrarAlta)
{
    <div class="card alta">
        <form class="form-grid" @onsubmit="CrearUsuario" novalidate>
            <div class="form-row">
                <div>
                    <label class="lbl" for="alta-ci">Cédula de identidad</label>
                    <input id="alta-ci" class="field mono" inputmode="numeric"
                           @bind="_nuevo.Dni" @bind:event="oninput" />
                </div>
                <div>
                    <label class="lbl" for="alta-tipo">Tipo de usuario</label>
                    <select id="alta-tipo" class="field" @bind="_tipoNuevo">
                        @foreach (string tipo in _tipos)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
            </div>
            <CamposDatosPersonales Prefijo="alta-" @bind-Nombre="_nuevo.Nombre" @bind-Apellido="_nuevo.Apellido"
                                   @bind-Correo="_nuevo.Correo" />
            <div class="hint">
                La cuenta se crea con la contraseña <strong class="mono">@ServicioAdministracionUsuarios.ContrasenaPredeterminada</strong>
                y el usuario debe cambiarla en su primer ingreso.
            </div>
            <div class="acciones">
                <button type="submit" class="btn btn-primary" disabled="@(!AltaCompleta)">Crear usuario</button>
                <button type="button" class="btn btn-ghost" @onclick="CancelarAlta">Cancelar</button>
            </div>
        </form>
    </div>
}

@if (_editando is not null)
{
    <div class="card alta">
        <form class="form-grid" @onsubmit="GuardarEdicion" novalidate>
            <div class="lbl">Editar datos de la cédula <span class="mono">@_editando.Dni</span></div>
            <CamposDatosPersonales Prefijo="edicion-" @bind-Nombre="_editando.Nombre"
                                   @bind-Apellido="_editando.Apellido" @bind-Correo="_editando.Correo" />
            <div class="acciones">
                <button type="submit" class="btn btn-primary" disabled="@(!EdicionCompleta)">Guardar cambios</button>
                <button type="button" class="btn btn-ghost" @onclick="CancelarEdicion">Cancelar</button>
            </div>
        </form>
    </div>
}

@if (_exito is not null)
{
    <div class="alert alert-success mensaje" role="status">@_exito</div>
}

@if (_error is not null)
{
    <div class="alert alert-error mensaje" role="alert">@_error</div>
}

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Cédula</th>
                <th>Correo</th>
                <th>Tipo de usuario</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody @key="_recargas">
            @foreach (UsuarioResumenDto usuario in UsuariosFiltrados)
            {
                <tr>
                    <td>@usuario.Nombre @usuario.Apellido</td>
                    <td class="mono">@usuario.Dni</td>
                    <td>@usuario.Correo</td>
                    <td>
                        <select class="field" aria-label="Tipo de @usuario.Nombre" disabled="@EsElMismo(usuario)"
                                value="@usuario.Tipo" @onchange="e => AsignarTipo(usuario, e.Value?.ToString())">
                            @foreach (string tipo in _tipos)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </select>
                    </td>
                    <td>@(usuario.Activo ? "Activo" : "Desactivado")</td>
                    <td>
                        <button class="btn btn-ghost btn-sm" @onclick="() => AbrirEdicion(usuario)">Editar</button>
                        @if (!EsElMismo(usuario))
                        {
                            <button class="btn btn-ghost btn-sm" @onclick="() => CambiarEstado(usuario)">
                                @(usuario.Activo ? "Desactivar" : "Reactivar")
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!UsuariosFiltrados.Any())
    {
        <EstadoVacio Titulo="No hay usuarios que coincidan" />
    }
</div>
