@page "/entregas"
@using DTOs
@using Servicios
@inherits PaginaConSesion
@inject ServicioPrestamo ServicioPrestamo

<PageTitle>UCD · Entregas</PageTitle>

<div class="page-header">
    <h1>Entregas</h1>
    <p>Registrá la entrega de las unidades de los préstamos activos cuando el solicitante las retira.</p>
</div>

@if (_exito is not null)
{
    <div class="alert alert-success mensaje" role="status">@_exito</div>
}

@if (_avisoLista is not null)
{
    <div class="alert alert-error mensaje" role="alert">@_avisoLista</div>
}

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Solicitante</th>
                <th>Equipo</th>
                <th>Cantidad</th>
                <th>Unidades</th>
                <th>Fecha del préstamo</th>
                <th>Devolución esperada</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (PrestamoDto prestamo in _prestamos)
            {
                <tr>
                    <td>@prestamo.Solicitante</td>
                    <td>@prestamo.TipoEquipamiento</td>
                    <td>@prestamo.CantidadSolicitada</td>
                    <td class="mono">@string.Join(", ", prestamo.Unidades)</td>
                    <td>@prestamo.FechaHoraPrestamo.ToString(FormatoFecha)</td>
                    <td>@prestamo.FechaEsperadaDevolucion.ToString(FormatoFechaEsperada)</td>
                    <td>
                        <button class="btn btn-ghost btn-sm" @onclick="() => RegistrarEntrega(prestamo)">
                            Registrar entrega
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!_prestamos.Any())
    {
        <EstadoVacio Titulo="No hay préstamos pendientes de entrega"
                     Mensaje="Los préstamos activos sin entrega registrada van a aparecer acá." />
    }
</div>
