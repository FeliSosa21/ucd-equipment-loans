@page "/entregas"
@using DTOs
@using Servicios
@inherits PaginaConSesion
@inject ServicioPrestamo ServicioPrestamo

<PageTitle>UCD · Entregas</PageTitle>

<div class="page-header">
    <h1>Entregas</h1>
    <p>Entregá las unidades de los préstamos aprobados al retirarlas el solicitante.</p>
</div>

<div class="toolbar">
    <input class="field busqueda" type="search" placeholder="Buscar por equipo o usuario"
           aria-label="Buscar préstamo" @bind="_busqueda" @bind:event="oninput" />
</div>

@if (_exito is not null)
{
    <div class="alert alert-success mensaje" role="status">@_exito</div>
}

@if (_avisoLista is not null)
{
    <div class="alert alert-error mensaje" role="alert">@_avisoLista</div>
}

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Solicitante</th>
                <th>Equipo</th>
                <th>Cantidad</th>
                <th>Inicio</th>
                <th>Unidades</th>
                <th>Devolución esperada</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (PrestamoDto prestamo in PrestamosFiltrados)
            {
                <tr>
                    <td>@prestamo.Solicitante</td>
                    <td>@prestamo.TipoEquipamiento</td>
                    <td>@prestamo.CantidadSolicitada</td>
                    <td>@prestamo.FechaHoraPrestamo.ToString(FormatoFecha)</td>
                    <td class="mono">@string.Join(", ", prestamo.Unidades)</td>
                    <td>@prestamo.FechaEsperadaDevolucion.ToString(FormatoFechaEsperada)</td>
                    <td>
                        <button class="btn btn-ghost btn-sm" @onclick="() => Entregar(prestamo)">Entregar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!_prestamos.Any())
    {
        <EstadoVacio Titulo="No hay préstamos para entregar"
                     Mensaje="Los préstamos aprobados van a aparecer acá para entregarlos." />
    }
    else if (!PrestamosFiltrados.Any())
    {
        <EstadoVacio Titulo="No hay préstamos que coincidan"
                     Mensaje="Probá buscando por otro nombre de usuario o de equipo." />
    }
</div>
