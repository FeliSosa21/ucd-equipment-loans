@page "/auditoria"

<PageTitle>UCD · Registro histórico</PageTitle>

<div class="page-header">
    <h1>Registro histórico</h1>
    <p>Préstamos y devoluciones registrados en el sistema. Los movimientos no se pueden modificar ni eliminar.</p>
</div>

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Fecha y hora</th>
                <th>Movimiento</th>
                <th>Solicitante</th>
                <th>Aprobó / rechazó</th>
                <th>Unidad</th>
            </tr>
        </thead>
    </table>
    <EstadoVacio Titulo="Todavía no hay movimientos" />
</div>
