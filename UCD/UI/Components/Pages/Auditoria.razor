@page "/auditoria"
@using DTOs
@using Servicios
@inherits PaginaConSesion
@inject ServicioHistorico ServicioHistorico

<PageTitle>UCD · Registro histórico</PageTitle>

<div class="page-header">
    <h1>Registro histórico</h1>
    <p>Solicitudes, aprobaciones, rechazos, préstamos y devoluciones registrados en el sistema. Los movimientos no se pueden modificar ni eliminar.</p>
</div>

<div class="toolbar">
    <select class="field" aria-label="Tipo de movimiento" @bind="_tipo">
        <option value="@TodosLosTipos">Todos</option>
        @foreach (KeyValuePair<string, string> tipo in NombresDeTipo)
        {
            <option value="@tipo.Key">@tipo.Value</option>
        }
    </select>
</div>

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Fecha y hora</th>
                <th>Tipo</th>
                <th>Solicitante</th>
                <th>Evaluador</th>
                <th>Unidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (MovimientoDto movimiento in MovimientosFiltrados)
            {
                <tr>
                    <td>@movimiento.FechaHora.ToString(FormatoFecha)</td>
                    <td>@TraducirTipo(movimiento.Tipo)</td>
                    <td>@movimiento.Solicitante</td>
                    <td>@(movimiento.Evaluador ?? SinDato)</td>
                    <td class="mono">@(movimiento.Unidad ?? SinDato)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!_movimientos.Any())
    {
        <EstadoVacio Titulo="Todavía no hay movimientos"
                     Mensaje="Las solicitudes, aprobaciones, rechazos, préstamos y devoluciones van a aparecer acá a medida que se registren." />
    }
    else if (!MovimientosFiltrados.Any())
    {
        <EstadoVacio Titulo="No hay movimientos de este tipo"
                     Mensaje="Probá eligiendo otro tipo o «Todos»." />
    }
</div>
