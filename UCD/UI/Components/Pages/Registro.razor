@page "/registro"
@layout UI.Components.Layout.AuthLayout
@using DTOs
@using Servicios
@inject NavigationManager Navigation
@inject ServicioUsuario ServicioUsuario
@inject SesionActual SesionActual

<PageTitle>UCD · Crear cuenta</PageTitle>

<div class="card registro">
    <div class="page-header">
        <h1>Crear cuenta</h1>
        <p>Completá tus datos para registrarte en UCD.</p>
    </div>

    <form class="form-grid" @onsubmit="Registrar" novalidate>
        <div>
            <label class="lbl" for="ci">Cédula de identidad</label>
            <input id="ci" class="field mono" inputmode="numeric" autocomplete="off" spellcheck="false"
                   aria-invalid="@_errores.Tiene(CampoDni)" aria-describedby="@_errores.IdDelError(CampoDni, "ci")"
                   placeholder="12345672" @bind="_ci" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoDni)" />
            <ErrorDeCampo Errores="_errores" Campo="@CampoDni" IdDelCampo="ci" />
            <div class="hint">Sin puntos ni guion, incluyendo el dígito verificador.</div>
        </div>

        <div class="form-row">
            <div>
                <label class="lbl" for="nombre">Nombre</label>
                <input id="nombre" class="field" autocomplete="given-name"
                       aria-invalid="@_errores.Tiene(CampoNombre)" aria-describedby="@_errores.IdDelError(CampoNombre, "nombre")"
                       @bind="_nombre" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoNombre)" />
                <ErrorDeCampo Errores="_errores" Campo="@CampoNombre" IdDelCampo="nombre" />
                <div class="hint">Entre 2 y 50 caracteres.</div>
            </div>
            <div>
                <label class="lbl" for="apellido">Apellido</label>
                <input id="apellido" class="field" autocomplete="family-name"
                       aria-invalid="@_errores.Tiene(CampoApellido)" aria-describedby="@_errores.IdDelError(CampoApellido, "apellido")"
                       @bind="_apellido" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoApellido)" />
                <ErrorDeCampo Errores="_errores" Campo="@CampoApellido" IdDelCampo="apellido" />
                <div class="hint">Entre 2 y 50 caracteres.</div>
            </div>
        </div>

        <div>
            <label class="lbl" for="correo">Correo electrónico</label>
            <input id="correo" type="email" class="field" autocomplete="email" spellcheck="false"
                   aria-invalid="@_errores.Tiene(CampoCorreo)" aria-describedby="@_errores.IdDelError(CampoCorreo, "correo")"
                   placeholder="nombre@ejemplo.com" @bind="_correo" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoCorreo)" />
            <ErrorDeCampo Errores="_errores" Campo="@CampoCorreo" IdDelCampo="correo" />
        </div>

        <div class="form-row">
            <div>
                <label class="lbl" for="contrasena">Contraseña</label>
                <input id="contrasena" type="@TipoContrasena" class="field" autocomplete="new-password"
                       aria-invalid="@_errores.Tiene(CampoContrasena)" aria-describedby="@_errores.IdDelError(CampoContrasena, "contrasena")"
                       @bind="_contrasena" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoContrasena)" />
                <ErrorDeCampo Errores="_errores" Campo="@CampoContrasena" IdDelCampo="contrasena" />
            </div>
            <div>
                <label class="lbl" for="repetir">Repetir contraseña</label>
                <input id="repetir" type="@TipoContrasena" class="field" autocomplete="new-password"
                       aria-invalid="@_errores.Tiene(CampoRepetir)" aria-describedby="@_errores.IdDelError(CampoRepetir, "repetir")"
                       @bind="_repetirContrasena" @bind:event="oninput" @bind:after="() => _errores.QuitarDe(CampoRepetir)" />
                <ErrorDeCampo Errores="_errores" Campo="@CampoRepetir" IdDelCampo="repetir" />
            </div>
        </div>

        <MostrarContrasena @bind-Visible="_mostrarContrasena" />

        <div class="alert alert-info">
            Al registrarte tu cuenta queda <strong>sin permisos</strong> hasta que un administrador
            te asigne un tipo de usuario.
        </div>

        @if (_errores.General is not null)
        {
            <div class="alert alert-error" role="alert">@_errores.General</div>
        }

        <button type="submit" class="btn btn-primary btn-block" disabled="@(!FormularioCompleto)">
            Crear cuenta
        </button>

        <p class="volver">¿Ya tenés cuenta? <a href="ingresar">Ingresá</a> · <a href="">Volver al inicio</a></p>
    </form>
</div>

@code {
    private string _ci = string.Empty;
    private string _nombre = string.Empty;
    private string _apellido = string.Empty;
    private string _correo = string.Empty;
    private string _contrasena = string.Empty;
    private string _repetirContrasena = string.Empty;
    private readonly ErroresDeFormulario _errores = new ErroresDeFormulario();

    private const string CampoDni = nameof(UsuarioDto.Dni);
    private const string CampoNombre = nameof(UsuarioDto.Nombre);
    private const string CampoApellido = nameof(UsuarioDto.Apellido);
    private const string CampoCorreo = nameof(UsuarioDto.Correo);
    private const string CampoContrasena = nameof(UsuarioDto.Contrasena);
    private const string CampoRepetir = "Repetir";
    private bool _mostrarContrasena;
    private bool _registrado;

    private string TipoContrasena => MostrarContrasena.TipoDeCampo(_mostrarContrasena);

    private bool FormularioCompleto =>
        !string.IsNullOrWhiteSpace(_ci) &&
        !string.IsNullOrWhiteSpace(_nombre) &&
        !string.IsNullOrWhiteSpace(_apellido) &&
        !string.IsNullOrWhiteSpace(_correo) &&
        !string.IsNullOrEmpty(_contrasena) &&
        !string.IsNullOrEmpty(_repetirContrasena);

    // Con una sesion iniciada no tiene sentido crear otra cuenta.
    protected override void OnInitialized()
    {
        if (SesionActual.EstaIniciada)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void Registrar()
    {
        // Un doble clic manda dos envios: el segundo llega con la cuenta ya creada y daria "ya existe".
        if (_registrado)
        {
            return;
        }

        _errores.Limpiar();

        if (_contrasena != _repetirContrasena)
        {
            _errores.AgregarEnCampo(CampoRepetir, "Las contraseñas no coinciden.");
            return;
        }

        try
        {
            ServicioUsuario.Registrar(CrearDto());
            _registrado = true;
            Navigation.NavigateTo("/pendiente-activacion");
        }
        catch (ServicioException ex)
        {
            _errores.Agregar(ex);
        }
    }

    private UsuarioDto CrearDto()
    {
        return new UsuarioDto
        {
            Dni = _ci.Trim(),
            Nombre = _nombre.Trim(),
            Apellido = _apellido.Trim(),
            Correo = _correo.Trim(),
            Contrasena = _contrasena
        };
    }
}
