@page "/prestamos"
@using DTOs
@using Servicios
@inherits PaginaConSesion
@inject ServicioPrestamo ServicioPrestamo

<PageTitle>UCD · Préstamos</PageTitle>

<div class="page-header">
    <h1>Préstamos</h1>
    <p>Las solicitudes y préstamos del período elegido, con su estado, del más reciente al más viejo. Las fechas incluyen el día completo.</p>
</div>

<div class="toolbar">
    <div>
        <label class="lbl" for="filtro-desde">Desde</label>
        <input id="filtro-desde" class="field" type="date"
               aria-invalid="@_errores.AriaInvalid(CampoDesde)"
               aria-describedby="@_errores.IdDelError(CampoDesde, "filtro-desde")"
               @bind="_desde" />
        <ErrorDeCampo Errores="_errores" Campo="@CampoDesde" IdDelCampo="filtro-desde" />
    </div>
    <div>
        <label class="lbl" for="filtro-hasta">Hasta</label>
        <input id="filtro-hasta" class="field" type="date" @bind="_hasta" />
    </div>
    <div>
        <label class="lbl" for="filtro-estado">Estado</label>
        <select id="filtro-estado" class="field" @bind="_estado">
            <option value="@TodosLosEstados">Todos</option>
            @foreach (string estado in Estados)
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
    <button type="button" class="btn btn-primary btn-sm" @onclick="Buscar">Buscar</button>
</div>

@if (_errores.General is not null)
{
    <div class="alert alert-error mensaje" role="alert">@_errores.General</div>
}

<div class="card table-card">
    <table>
        <thead>
            <tr>
                <th>Solicitante</th>
                <th>Equipo</th>
                <th>Cantidad</th>
                <th>Estado</th>
                <th>Fecha del préstamo</th>
                <th>Devolución esperada</th>
                <th>Unidades</th>
                <th>Motivo de rechazo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (PrestamoDto prestamo in _prestamos)
            {
                <tr>
                    <td>@prestamo.Solicitante</td>
                    <td>@prestamo.TipoEquipamiento</td>
                    <td>@prestamo.CantidadSolicitada</td>
                    <td>@prestamo.Estado</td>
                    <td>@prestamo.FechaHoraPrestamo.ToString(Formatos.FechaHora)</td>
                    <td>@(prestamo.Estado == EstadosPrestamo.Rechazado ? SinDato : prestamo.FechaEsperadaDevolucion.ToString(Formatos.Fecha))</td>
                    <td class="mono">@(prestamo.Unidades.Any() ? string.Join(", ", prestamo.Unidades) : SinDato)</td>
                    <td>@(prestamo.MotivoRechazo ?? SinDato)</td>
                </tr>
            }
        </tbody>
    </table>
    @if (!_prestamos.Any() && !HayError)
    {
        <EstadoVacio Titulo="No hay préstamos en ese período"
                     Mensaje="Probá con otro rango de fechas o con «Todos»." />
    }
</div>
