@page "/ingresar"
@layout UI.Components.Layout.AuthLayout
@rendermode InteractiveServer
@using DTOs
@using Servicios
@inject NavigationManager Navigation
@inject ServicioSesion ServicioSesion

<PageTitle>UCD · Ingresar</PageTitle>

<div class="card formulario">
    <div class="page-header">
        <h1>Ingresar</h1>
        <p>Usá tu correo y contraseña de UCD.</p>
    </div>

    <form class="form-grid" @onsubmit="IniciarSesion" novalidate>
        <div>
            <label class="lbl" for="correo">Correo electrónico</label>
            <input id="correo" type="email" class="field" autocomplete="email"
                   @bind="_correo" @bind:event="oninput" />
        </div>
        <div>
            <label class="lbl" for="contrasena">Contraseña</label>
            <input id="contrasena" type="@TipoContrasena" class="field" autocomplete="current-password"
                   @bind="_contrasena" @bind:event="oninput" />
        </div>

        <label class="mostrar">
            <input type="checkbox" @bind="_mostrarContrasena" />
            Mostrar contraseña
        </label>

        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        <button type="submit" class="btn btn-primary btn-block" disabled="@(!FormularioCompleto)">
            Ingresar
        </button>

        <p class="alternativa">¿No tenés cuenta? <a href="registro">Registrate</a> · <a href="">Volver al inicio</a></p>
    </form>
</div>

@code {
    private string _correo = string.Empty;
    private string _contrasena = string.Empty;
    private string? _error;
    private bool _mostrarContrasena;

    private string TipoContrasena => _mostrarContrasena ? "text" : "password";

    private bool FormularioCompleto =>
        !string.IsNullOrWhiteSpace(_correo) && !string.IsNullOrEmpty(_contrasena);

    private void IniciarSesion()
    {
        _error = null;
        try
        {
            UsuarioSesionDto sesion = ServicioSesion.IniciarSesion(_correo.Trim(), _contrasena);
            Navigation.NavigateTo(PaginaDeInicio(sesion));
        }
        catch (ServicioException ex)
        {
            _error = ex.Message;
        }
    }

    private static string PaginaDeInicio(UsuarioSesionDto sesion)
    {
        if (sesion.DebeCambiarContrasena)
        {
            return "/cambiar-contrasena";
        }

        if (sesion.PendienteDeActivacion)
        {
            return "/pendiente-activacion";
        }

        return "/";
    }
}
