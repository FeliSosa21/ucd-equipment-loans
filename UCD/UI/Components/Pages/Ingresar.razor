@page "/ingresar"
@layout UI.Components.Layout.AuthLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>UCD · Ingresar</PageTitle>

<div class="card formulario">
    <div class="page-header">
        <h1>Ingresar</h1>
        <p>Usá tu correo y contraseña de UCD.</p>
    </div>

    <form class="form-grid" @onsubmit="IniciarSesion" novalidate>
        <div>
            <label class="lbl" for="correo">Correo electrónico</label>
            <input id="correo" type="email" class="field" autocomplete="email"
                   @bind="_correo" @bind:event="oninput" />
        </div>
        <div>
            <label class="lbl" for="contrasena">Contraseña</label>
            <input id="contrasena" type="password" class="field" autocomplete="current-password"
                   @bind="_contrasena" @bind:event="oninput" />
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-error" role="alert">@_error</div>
        }

        <button type="submit" class="btn btn-primary btn-block" disabled="@(!FormularioCompleto)">
            Ingresar
        </button>

        <p class="alternativa">¿No tenés cuenta? <a href="registro">Registrate</a> · <a href="">Volver al inicio</a></p>
    </form>
</div>

@code {
    private string _correo = string.Empty;
    private string _contrasena = string.Empty;
    private string? _error;

    private bool FormularioCompleto =>
        !string.IsNullOrWhiteSpace(_correo) && !string.IsNullOrEmpty(_contrasena);

    private void IniciarSesion()
    {
        _error = null;
        try
        {
            // TODO: llamar al servicio de ingreso. Si es el primer ingreso, ir a /cambiar-contrasena;
            // si el usuario no tiene tipo asignado, ir a /pendiente-activacion.
            Navigation.NavigateTo("/");
        }
        catch (Exception ex) // TODO: cambiar por la excepción que tire el servicio
        {
            _error = ex.Message;
        }
    }
}
