@page "/catalogo"
@inherits PaginaConSesion
@using DTOs
@using Servicios
@inject ServicioCatalogo ServicioCatalogo

<PageTitle>UCD · Catálogo</PageTitle>

<div class="page-header">
    <h1>Catálogo de equipamiento</h1>
    <p>Elegí un tipo de equipamiento para ver su disponibilidad y solicitar un préstamo.</p>
</div>

<div class="toolbar">
    <select class="field" aria-label="Categoría">
                <option value="">Todas las categorías</option>
                <option>Computación</option>
                <option>Audiovisual</option>
                <option>Laboratorio</option>
                <option>Electrónica</option>
                <option>Accesorios</option>
    </select>
    <select class="field" aria-label="Disponibilidad">
        <option value="">Cualquier disponibilidad</option>
        <option>Con unidades disponibles</option>
        <option>Sin unidades disponibles</option>
    </select>
    <select class="field" aria-label="Estado">
        <option value="">Activos y discontinuados</option>
        <option>Solo activos</option>
        <option>Solo discontinuados</option>
    </select>
</div>

@if (_error is not null)
{
    <div class="alert alert-error mensaje" role="alert">@_error</div>
}

<p class ="hint resultados" role ="status">@TextoResultados()</p>

@if (_tipos.Count == 0)
{
    <div class="card">
        <EstadoVacio Titulo="No hay equipamiento que coincida con los filtros"
                     Mensaje="Probá con otra categoría, otro estado o un mínimo de disponibles más bajo." />
    </div>
}
else
{
    <div class="card table-card">
        <table>
            <thead>
            <tr>
                <th>Tipo de equipamiento</th>
                <th>Categoría</th>
                <th>Estado</th>
                <th>Disponibles</th>
            </tr>
            </thead>
            <tbody>
            @foreach (TipoEquipamientoDto tipo in _tipos)
            {
                <tr>
                    <td><strong>@tipo.Nombre</strong></td>
                    <td>@tipo.Categoria</td>
                    <td><span class="badge @ClaseDeEstado(tipo.Estado)">@tipo.Estado</span></td>
                    <td>@tipo.CantidadDisponibles</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
